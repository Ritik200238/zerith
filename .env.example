PRIVATE_KEY=0x_your_private_key_here
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ─── Frontend embedded burner ("Try Instantly") ───────────────────────
# Set these in cipherdex/frontend/.env.local locally, and in Vercel's
# Project Environment Variables for prod. NEVER commit real values.
#
# BURNER_FUNDER_PRIVATE_KEY: key of a testnet-only hot wallet that pays gas for
# demo burners. The burner's own key is created in the browser; the server only
# sends its address a top-up sized from live gas prices. Never the deployer key.
BURNER_FUNDER_PRIVATE_KEY=
# Optional bounds per top-up (ETH) and limits. Defaults shown.
# BURNER_MIN_FUND_ETH=0.0002
# BURNER_MAX_FUND_ETH=0.005
# BURNER_IP_WINDOW_MS=21600000
# BURNER_HOURLY_CAP=60
# Optional: shared rate limits across serverless instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
