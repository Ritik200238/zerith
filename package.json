{
  "name": "zerith",
  "version": "1.0.0",
  "description": "Zerith - encrypted block sales, treasury and payroll on Fhenix FHE",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "clean": "npx hardhat clean",
    "deploy:local": "npx hardhat run tasks/deploy-core.ts",
    "deploy:sepolia": "npx hardhat run tasks/deploy-core.ts --network ethSepolia",
    "e2e:sepolia": "npx hardhat run tasks/verify-escrow-auction-e2e.ts --network ethSepolia",
    "verify:mobile": "node tasks/verify-mobile-responsive.mjs",
    "verify:mobile:archive": "node tasks/verify-mobile-responsive.mjs --archive",
    "seed:sepolia": "npx hardhat run tasks/seed-live-auctions.ts --network ethSepolia"
  },
  "dependencies": {
    "@fhenixprotocol/cofhe-contracts": "1.0.0",
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@cofhe/hardhat-plugin": "0.8.0",
    "@cofhe/mock-contracts": "0.8.0",
    "@cofhe/sdk": "0.8.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.4.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
